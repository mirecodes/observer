{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woko-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "observability": { "enabled": true },
  // cfgs/*.yml + src/modules/*/cfg.yml → gen/config.json (deploy/dev 때마다)
  "build": { "command": "node scripts/build-config.mjs", "watch_dir": ["src", "cfgs"] },
  "triggers": {
    // UTC 기준 5분마다. 일시 정지하려면 [] 로 바꾸고 다시 배포.
    "crons": ["*/5 * * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "7136430821ed490b967e82c36e1f0617",
    },
  ],
  // 설정은 cfgs/ 와 src/modules/*/cfg.yml 에. 비밀값(NTFY_TOPIC, NTFY_TOKEN, PUSHOVER_TOKEN, PUSHOVER_USER)은
  // `npx wrangler secret put <이름>` 으로만 설정
}
